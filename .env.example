# Public domain (used by Caddy and for absolute URLs in production)
SITE_DOMAIN=example.com

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Postgres (used by both compose files)
POSTGRES_DB=carrot
POSTGRES_USER=carrot
POSTGRES_PASSWORD=carrot
# Local development connection (compose overrides this inside containers)
DATABASE_URL=postgres://carrot:carrot@localhost:5432/carrot

# First admin user, created by `bootstrap_site` if it does not exist
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# URLs for local development (compose overrides these with https://SITE_DOMAIN)
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
WAGTAIL_INTERNAL_URL=http://localhost:8000
